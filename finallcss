/* ==========================================================================
   Silver Diner — Diner Perks Loyalty Iframe Styles
   Layout modeled on the Keke's Rewards signup screen:
   - Warm off-white page background (#F7F5F2)
   - Single centered white form card
   - Diner Perks logo at top of card (replaces text header)
   - White input fields with subtle border
   - Navy submit button
   - Single-column form (no Facebook side column)

   Brand palette:
     --sd-bg:         #F7F5F2   (page background)
     --sd-cta:        #003461   (navy submit button)
     --sd-field:      #FFFFFF   (input fill)
   ========================================================================== */

:root {
  /* Page background */
  --sd-bg:       #F7F5F2;   /* warm off-white page background (per designer) */
  --sd-bg-dark:  #E6E2DC;   /* darker variant for accents */

  /* Primary action — sign up / submit button */
  --sd-red:        #003461;   /* deep navy CTA (per designer) */
  --sd-red-dark:   #002648;   /* hover */
  --sd-red-deep:   #001A33;   /* pressed */

  /* Form input fill */
  --sd-cream:      #FFFFFF;   /* white input field (per designer) */
  --sd-cream-dk:   #D9D5CE;   /* subtle border that reads against #f7f5f2 */

  /* Text & utility */
  --sd-charcoal:   #1A1A1A;
  --sd-ink:        #2B2B2B;
  --sd-gray:       #6E7378;
  --sd-gray-lt:    #A3A6AA;
  --sd-card-bg:    #FFFFFF;
}

@import url("https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&display=swap");
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  color: var(--sd-charcoal);
  font-family: "Raleway", sans-serif !important;
  min-height: 100vh;
  background: var(--sd-bg);
  background-repeat: no-repeat;
  background-position: center center;
  background-attachment: fixed;
  -webkit-background-size: cover;
  -moz-background-size: cover;
  -o-background-size: cover;
  background-size: cover;
}

body a {
  -moz-transition: .3s;
  -ms-transition: .3s;
  -o-transition: .3s;
  -webkit-transition: .3s;
  color: var(--sd-red);
  text-decoration: none !important;
  transition: .3s;
}
body a:hover {
  color: var(--sd-red-dark);
}

/* Common helpers */
.disp-table { display: table; width: 100%; }
.pos-relative { position: relative; }
.padt40    { padding-top: 40px; }
.padb20    { padding-bottom: 20px; }
.padnb120  { padding-bottom: 120px !important; }

/* ==========================================================================
   Header — hidden on signup/login; Diner Perks logo is injected at the
   top of the form card instead (see ::before below).
   ========================================================================== */
.iframe-header {
  padding: 0;
  margin: 0;
  text-align: center;
  box-sizing: border-box;
  width: 100%;
}
.navbar-div { display: none; }
.user-dahboard .navbar-div { display: block; }
.seprator { display: none; }

/* ==========================================================================
   Anchor styling — Forgot password, signup links, etc.
   ========================================================================== */
.forgot-div a,
.signup-form form a,
.info-div a {
  display: inline-block;
  float: right;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 1px;
  margin: 5px 0 10px;
  position: relative;
  text-align: right;
  text-decoration: none;
  text-transform: uppercase;
  color: var(--sd-red);
}
.forgot-div a:before,
.signup-form form a:before,
.info-div a:before {
  -webkit-transform: scaleX(0);
  -webkit-transition: all 0.3s ease-in-out 0s;
  background-color: var(--sd-red);
  bottom: 0;
  content: "";
  height: 2px;
  left: 0;
  position: absolute;
  transform: scaleX(0);
  transition: all 0.3s ease-in-out 0s;
  visibility: hidden;
  width: 100%;
}
.forgot-div a:hover:before,
.signup-form form a:hover:before,
.info-div a:hover:before {
  -webkit-transform: scaleX(1);
  transform: scaleX(1);
  visibility: visible;
}

/* ==========================================================================
   Card container — centered white form card on off-white background
   ========================================================================== */
.iframe-container {
  text-align: center;
  box-sizing: border-box;
  width: 100%;
  padding: 40px 20px;
}

.iframe-container .signup-form,
.iframe-container .login-form {
  width: 100%;
  max-width: 460px;
  margin: 0 auto;
  padding: 40px 40px 32px;
  background-color: var(--sd-card-bg);
  border-radius: 8px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
  position: relative;
}

@media screen and (max-width: 480px) {
  .iframe-container .signup-form,
  .iframe-container .login-form {
    max-width: 100%;
    padding: 32px 24px 24px;
    border-radius: 6px;
  }
}

/* Diner Perks logo injected at the top of the form card.
   Currently pulls from Silver Diner's CDN. Replace the URL below
   if you'd like to self-host the logo file. */
.iframe-container .signup-form::before,
.iframe-container .login-form::before {
  content: "";
  display: block;
  width: 180px;
  height: 90px;
  margin: 0 auto 24px;
  background-image: url("data:image/png;base64,");
  background-repeat: no-repeat;
  background-position: center center;
  background-size: contain;
}

@media screen and (max-width: 480px) {
  .iframe-container .signup-form::before,
  .iframe-container .login-form::before {
    width: 150px;
    height: 75px;
    margin-bottom: 18px;
  }
}

/* Form occupies the full card width (single column) */
.iframe-container form {
  display: block;
  width: 100%;
  padding-right: 0;
  vertical-align: top;
}

@media screen and (max-width: 480px) {
  .iframe-container form {
    width: 100%;
    padding: 0;
    margin: 0;
  }
}

.form-hint {
  font-size: 12px;
  font-weight: 300;
  letter-spacing: 0.5px;
  line-height: 14px;
  padding: 4px 0 10px;
  text-align: left;
  width: 100%;
  display: block;
  color: var(--sd-gray);
}

/* ==========================================================================
   Form fields — cream fill, matching the Keke reference
   ========================================================================== */
.iframe-container form input,
.iframe-container form textarea {
  background-color: var(--sd-cream);
  border: 1px solid var(--sd-cream-dk);
  box-sizing: border-box;
  color: var(--sd-charcoal);
  font-family: "Raleway", sans-serif;
  font-size: 14px;
  font-weight: 400;
  height: 44px;
  line-height: 44px;
  outline: none;
  padding: 5px 12px;
  width: 100%;
  border-radius: 4px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.iframe-container form input:focus,
.iframe-container form textarea:focus {
  border-color: var(--sd-red);
  box-shadow: 0 0 0 3px rgba(0, 52, 97, 0.18);
}

.iframe-container form label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.5px;
  margin: 14px 0 6px;
  text-align: left;
  text-transform: uppercase;
  color: var(--sd-charcoal);
}

.iframe-container form .error-messages {
  -webkit-font-smoothing: antialiased;
  color: var(--sd-red);
  display: block;
  letter-spacing: 0.5px;
  line-height: 18px;
  width: 100%;
  margin-bottom: 10px;
}
.iframe-container form .error-messages h2 {
  font-size: 14px;
  line-height: 14px;
  padding-bottom: 10px;
  text-align: left;
}
.iframe-container form .error-messages li {
  font-size: 13px;
  line-height: 16px;
  list-style: none;
  padding-bottom: 5px;
  text-align: left;
}

/* Primary submit button — Silver Diner red */
.iframe-container form .btn-submit,
.iframe-container form .submit-div input {
  background-color: var(--sd-red);
  border: none;
  color: #fff;
  cursor: pointer;
  display: inline-block;
  font-family: "Raleway", sans-serif;
  font-weight: 700;
  font-size: 15px;
  height: 48px;
  letter-spacing: 2px;
  line-height: 48px;
  padding: 0;
  text-transform: uppercase;
  width: 100%;
  border-radius: 4px;
  margin-top: 8px;
}
.iframe-container form .btn-submit:hover,
.iframe-container form .submit-div input:hover {
  transition: all 0.2s 0s;
  background-color: var(--sd-red-dark);
}
.iframe-container form .btn-submit:active,
.iframe-container form .submit-div input:active {
  background-color: var(--sd-red-deep);
}

/* ==========================================================================
   Facebook / social login — hidden to match the Keke's single-column layout.
   Remove these display:none rules if Facebook login is re-enabled.
   ========================================================================== */
.iframe-container .facebook-login-div,
.iframe-container .facebook-link,
.facebook-label,
.btn-fb {
  display: none !important;
}

/* ==========================================================================
   Login form layout
   ========================================================================== */
.login-form { position: relative; }
.login-form form {
  padding-top: 8px;
  padding-bottom: 8px;
}
.login-form .submit-div { margin-top: 20px; }

.forgot-div {
  position: static;
  text-align: right;
  width: 100%;
  margin-top: 4px;
}
.forgot-div::after {
  content: "";
  display: block;
  clear: both;
}

/* ==========================================================================
   Alerts
   ========================================================================== */
.alert-message {
  color: var(--sd-red);
  display: block;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.5px;
  text-align: center;
  width: 100%;
  padding: 10px 12px;
  background-color: rgba(0, 52, 97, 0.06);
  border-left: 3px solid var(--sd-red);
  border-radius: 4px;
  margin-bottom: 16px;
}
.alert-message strong { font-weight: 600; }

/* ==========================================================================
   Password recovery
   ========================================================================== */
.password-form .header-div {
  font-family: "Raleway", sans-serif;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 8px 0 20px;
  color: var(--sd-charcoal);
  text-align: center;
}
.password-form .submit-div { margin-top: 20px; }
.password-form .submit-div input { font-size: 15px !important; }

/* ==========================================================================
   eCRM registration extras — birthday selects, ZIP, checkboxes, etc.
   ========================================================================== */
.ecrm-registration-div select {
  background-color: var(--sd-cream);
  border: 1px solid var(--sd-cream-dk);
  box-sizing: border-box;
  color: var(--sd-charcoal);
  font-family: "Raleway", sans-serif;
  font-size: 14px;
  font-weight: 400;
  outline: none;
  padding: 10px;
  width: 32%;
  height: 44px;
  border-radius: 4px;
  transition: border-color 0.2s ease;
}
.ecrm-registration-div select:focus {
  border-color: var(--sd-red);
  box-shadow: 0 0 0 3px rgba(0, 52, 97, 0.18);
}
.ecrm-registration-div select#location_id { width: 100% !important; }

.ecrm-registration-div input[type="checkbox"] {
  display: inline-block;
  height: auto;
  margin-top: 6px;
  vertical-align: top;
  width: auto;
  float: left;
  accent-color: var(--sd-red);
}
.ecrm-registration-div form label.middle {
  display: inline-block;
  vertical-align: top;
  width: 88%;
  text-transform: none;
  font-weight: 400;
  font-size: 12px;
  letter-spacing: 0.3px;
  color: var(--sd-ink);
  margin-left: 8px;
  line-height: 16px;
}
.ecrm-registration-div .submit-div {
  margin-top: 20px;
  margin-bottom: 16px;
}
.ecrm-registration-div label.required:before {
  content: '*';
  color: var(--sd-red);
  display: inline-block;
  margin-right: 3px;
}

/* ==========================================================================
   User dashboard (post-login) — kept on light card, branded buttons
   ========================================================================== */
.user-dahboard { text-align: center; }
.user-dahboard .iframe-header,
.user-dahboard .iframe-container {
  display: inline-block;
  vertical-align: top;
  min-height: 298px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 8px;
  text-align: left;
  margin: 30px 0;
}
.user-dahboard .iframe-header {
  background-color: #fff;
  padding: 0;
  width: 238px;
  overflow: hidden;
}
.user-dahboard .iframe-header .header { display: none; }
.user-dahboard .iframe-header .navbar-div {
  width: 100%;
  padding: 0;
  display: block;
  font-size: 16pt;
}
.user-dahboard .iframe-header .navbar-div span a {
  border-top: 1px solid var(--sd-cream-dk);
  display: block;
  font-family: "Raleway", sans-serif;
  font-size: 14px;
  line-height: 14px;
  padding: 17px 0;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--sd-charcoal);
  text-align: center;
}
.user-dahboard .iframe-header .navbar-div span a:hover {
  background-color: var(--sd-cream);
  color: var(--sd-red);
}
.user-dahboard .iframe-header .navbar-div span.account-link a {
  border: none;
  border-radius: 8px 8px 0 0;
  background-color: var(--sd-charcoal);
  color: #fff;
  font-family: "Raleway", sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.5px;
}
.user-dahboard .iframe-header .navbar-div span.signout-link {
  border-radius: 0 0 8px 8px;
}
.user-dahboard .iframe-header .navbar-div span.signout-link a {
  background-color: var(--sd-red);
  border: none;
  color: #fff;
  font-family: "Raleway", sans-serif;
  font-size: 15px;
  font-weight: 700;
  line-height: 20px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  border-radius: 0 0 8px 8px;
}
.user-dahboard .iframe-header .navbar-div span.signout-link a:hover {
  background-color: var(--sd-red-dark);
}
.user-dahboard .iframe-header .navbar-div span + span:before {
  display: none;
}

.user-dahboard .iframe-container {
  background-color: #fff;
  width: 638px;
  padding: 20px;
  margin-left: 50px;
}

.user-dahboard .alert-message { width: auto; }
.user-dahboard .current-checkins-div {
  font-size: 16px;
  line-height: 25px;
  letter-spacing: 0.5px;
}
.user-dahboard .checkin-form form { width: 100%; }
.user-dahboard .barcode-digit,
.user-dahboard .barcode-example {
  color: var(--sd-gray);
  display: block;
  font-size: 12px;
  font-weight: 300;
  width: 100%;
  letter-spacing: 1px;
}
.user-dahboard textarea {
  font-weight: 300;
  letter-spacing: 1px;
  min-height: 100px;
}
.user-dahboard .feedback-share-div { display: block; }
.user-dahboard .feedback-share-div input {
  width: auto;
  vertical-align: middle;
}
.user-dahboard .feedback-share-div label {
  display: inline-block;
  margin: 0;
  vertical-align: middle;
  font-weight: 300;
  font-size: 13px;
  text-transform: none;
}
.user-dahboard .info-div,
.user-dahboard .expiry-warning {
  display: block;
  font-size: 16px;
  font-weight: 400;
  letter-spacing: 1px;
  padding: 10px 0;
}
.user-dahboard .info-div a,
.user-dahboard .expiry-warning a {
  float: none !important;
  font-size: 16px;
  font-weight: 500;
  color: var(--sd-red);
}
.user-dahboard .submit-div {
  width: 280px;
  margin: 0 auto;
  padding: 20px 0;
}
.user-dahboard .signup-form form,
.user-dahboard .redemption-form form { width: 100%; }
.user-dahboard .barcode-div { padding-bottom: 15px; }
.user-dahboard .expiry-warning { text-align: center; }

/* Dashboard form cards should not show the form-card logo
   (the logo is in the nav column) */
.user-dahboard .signup-form::before,
.user-dahboard .login-form::before {
  display: none;
}
.user-dahboard .signup-form,
.user-dahboard .login-form {
  box-shadow: none;
  padding: 0;
  max-width: none;
}
